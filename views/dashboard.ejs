<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Veille — Santé mentale au travail</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="topbar">
    <div>
      <h1>Veille — Santé mentale au travail</h1>
      <div class="sub">Connecté : <%= email %></div>
    </div>
    <div style="display:flex; gap:10px;">
      <button class="btn btn-ghost" onclick="lancerIngestion(this)">Actualiser maintenant</button>
      <a href="/compte" class="btn btn-ghost" style="text-decoration:none;">Mon compte</a>
      <form method="POST" action="/logout">
        <button type="submit" class="btn btn-ghost">Déconnexion</button>
      </form>
    </div>
  </div>

  <div class="container">
    <div class="nav-links">
      <a href="/" class="<%= !filters.saved ? 'active' : '' %>">Tous les articles</a>
      <a href="/favoris" class="<%= filters.saved === '1' ? 'active' : '' %>">★ Mes favoris</a>
    </div>

    <form class="filters" method="GET" action="/">
      <input type="text" name="q" placeholder="Rechercher un mot..." value="<%= filters.q || '' %>">

      <select name="keyword" onchange="this.form.submit()">
        <option value="">Tous les mots-clés</option>
        <% keywords.forEach(k => { %>
          <option value="<%= k.keyword %>" <%= filters.keyword === k.keyword ? 'selected' : '' %>><%= k.keyword %></option>
        <% }) %>
      </select>

      <select name="category" onchange="this.form.submit()">
        <option value="">Toutes les catégories</option>
        <% categories.forEach(c => { %>
          <option value="<%= c.category %>" <%= filters.category === c.category ? 'selected' : '' %>><%= c.category %></option>
        <% }) %>
      </select>

      <label style="display:flex; align-items:center; gap:6px; font-size:14px; cursor:pointer;">
        <input type="checkbox" name="saved" value="1" <%= filters.saved === '1' ? 'checked' : '' %> onchange="this.form.submit()">
        Favoris uniquement
      </label>

      <button type="submit" class="btn btn-primary">Filtrer</button>
    </form>

    <% if (articles.length === 0) { %>
      <div class="empty-state">
        <p>Aucun article pour le moment.</p>
        <p>Configurez vos flux Google Alerts dans <code>config/feeds.json</code>, puis cliquez sur « Actualiser maintenant ».</p>
      </div>
    <% } else { %>
      <% articles.forEach(a => { %>
        <div class="card" id="card-<%= a.id %>">
          <div class="meta">
            <span class="badge"><%= a.keyword %></span>
            <span class="badge terracotta"><%= a.category %></span>
            <span><%= a.source || 'Source inconnue' %></span>
            <span><%= a.published_at ? new Date(a.published_at).toLocaleDateString('fr-FR') : '' %></span>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:10px;">
            <h2><a href="<%= a.url %>" target="_blank" rel="noopener"><%= a.title %></a></h2>
            <button class="star-btn <%= a.saved ? 'active' : '' %>" onclick="toggleSave(<%= a.id %>, this)" title="Enregistrer cet article">★</button>
          </div>
          <p class="summary"><%= a.summary || 'Résumé indisponible.' %></p>
          <a class="source-link" href="<%= a.url %>" target="_blank" rel="noopener">Lire l'article original →</a>

          <div class="notes-block">
            <textarea class="notes-input" data-id="<%= a.id %>" placeholder="Pourquoi cet article est intéressant, idées à en tirer..."><%= a.notes || '' %></textarea>
            <label>Vos notes</label>
            <div class="notes-status" id="notes-status-<%= a.id %>"></div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <script>
    async function lancerIngestion(btn) {
      btn.disabled = true;
      btn.textContent = 'Récupération en cours...';
      try {
        const res = await fetch('/api/ingest', { method: 'POST' });
        const data = await res.json();
        if (data.ok) {
          location.reload();
        } else {
          alert("Erreur pendant l'ingestion : " + data.error);
        }
      } catch (e) {
        alert("Erreur réseau pendant l'ingestion.");
      } finally {
        btn.disabled = false;
        btn.textContent = 'Actualiser maintenant';
      }
    }

    async function toggleSave(id, btn) {
      try {
        const res = await fetch(`/api/articles/${id}/save`, { method: 'POST' });
        const data = await res.json();
        if (data.ok) {
          btn.classList.toggle('active', data.saved);
        }
      } catch (e) {
        alert("Erreur réseau, réessayez.");
      }
    }

    let notesTimers = {};
    document.querySelectorAll('.notes-input').forEach((el) => {
      el.addEventListener('input', () => {
        const id = el.dataset.id;
        const statusEl = document.getElementById(`notes-status-${id}`);
        statusEl.textContent = '...';
        clearTimeout(notesTimers[id]);
        notesTimers[id] = setTimeout(async () => {
          try {
            const res = await fetch(`/api/articles/${id}/notes`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ notes: el.value })
            });
            const data = await res.json();
            statusEl.textContent = data.ok ? 'Enregistré ✓' : 'Erreur';
            setTimeout(() => { statusEl.textContent = ''; }, 2000);
          } catch (e) {
            statusEl.textContent = 'Erreur réseau';
          }
        }, 700);
      });
    });
  </script>
</body>
</html>
