# Copiez ce fichier en ".env" et remplissez les valeurs

PORT=3000
SESSION_SECRET=changez-cette-valeur-par-une-chaine-aleatoire-longue

# Obligatoire : URL de connexion PostgreSQL (ex: fournie par Neon)
DATABASE_URL=

# Compte créé automatiquement au premier lancement (si aucun utilisateur n'existe)
ADMIN_EMAIL=admin@holismose.fr
ADMIN_PASSWORD=changez-moi

# Optionnel : active le résumé via l'API Claude (sinon résumé naïf par défaut)
ANTHROPIC_API_KEY=

# Planification de l'ingestion automatique (format cron). Par défaut : toutes les 6h.
INGEST_CRON=0 */6 * * *
